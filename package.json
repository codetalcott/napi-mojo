{
  "name": "napi-mojo",
  "version": "0.10.0",
  "description": "Build Node.js native addons in Mojo — the Mojo equivalent of napi-rs",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "napi-mojo": "./bin/napi-mojo.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./demo": {
      "types": "./build/index.d.ts",
      "default": "./demo.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "demo.js",
    "build/index.d.ts",
    "src/",
    "!src/addon",
    "!src/lib.mojo",
    "!src/generated",
    "!src/exports.toml",
    "examples/",
    "!examples/codegen/build",
    "!examples/codegen/generated",
    "!examples/tutorial/build",
    "!examples/tutorial/generated",
    "bin/",
    "scripts/generate-addon.mjs",
    "scripts/generate-dts.js",
    "scripts/toml-lite.js",
    "scripts/toml-dts.js",
    "scripts/bundle-runtime.sh",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetalcott/napi-mojo.git"
  },
  "bugs": {
    "url": "https://github.com/codetalcott/napi-mojo/issues"
  },
  "homepage": "https://github.com/codetalcott/napi-mojo#readme",
  "scripts": {
    "build": "bash build.sh && npm run generate:dts",
    "generate:dts": "node scripts/generate-dts.js",
    "generate:addon": "node scripts/generate-addon.mjs",
    "generate:docs": "npm run generate:dts && npx typedoc build/index.d.ts --out docs/api-demo-addon --name 'napi-mojo demo addon'",
    "check:docstrings": "node scripts/check-docstring-coverage.mjs",
    "check:benchmark": "node scripts/check-benchmark.mjs",
    "test": "jest",
    "test:gc": "NODE_OPTIONS='--expose-gc' npx jest tests/finalizer_gc.test.js",
    "version": "node scripts/sync-versions.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "author": "Wm Talcott <wtalcott@gmail.com>",
  "keywords": [
    "napi",
    "mojo",
    "native-addon",
    "ffi",
    "n-api",
    "node-addon"
  ],
  "optionalDependencies": {
    "@napi-mojo/darwin-arm64": "0.10.0",
    "@napi-mojo/linux-x64": "0.10.0"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  }
}
